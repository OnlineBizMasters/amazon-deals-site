# ---------------------------------------------------------------------------
# DealScout configuration
#
# Copy to .env.local and edit. Every value is optional: with an empty file the
# app runs on SQLite with manual and CSV offer sources, seeds a labelled demo
# catalogue, and accepts a development admin password.
#
# Never commit real credentials. .env* is git-ignored.
# ---------------------------------------------------------------------------

# --- Storage ---------------------------------------------------------------
# SQLite file location. Relative paths resolve from the project root.
# Use ":memory:" for a throwaway database (tests already do).
DATABASE_PATH=.data/dealscout.db

# Set to 0 to stop the demo catalogue being seeded into an empty database.
DEALSCOUT_AUTO_SEED=1

# --- Site ------------------------------------------------------------------
# Public origin, no trailing slash. Used for canonical URLs, Open Graph tags,
# the sitemap and the tracked links in generated social content.
#
# Until this is set, robots.txt disallows all crawling so previews and local
# runs stay out of search indexes.
#
# SITE_URL is read at runtime. NEXT_PUBLIC_SITE_URL is inlined at build time —
# only use it if the origin is known when you build.
SITE_URL=https://your-domain.example

# Shown on the affiliate disclosure, privacy and terms pages.
CONTACT_EMAIL=hello@your-domain.example

# --- Admin access ----------------------------------------------------------
# Required in production: without it the admin dashboard is disabled entirely.
# In development, the password "dealscout-dev" is accepted and a warning banner
# is shown.
ADMIN_PASSWORD=

# Signing key for the admin session cookie. Defaults to ADMIN_PASSWORD; set it
# separately so rotating the password does not have to invalidate sessions.
ADMIN_SESSION_SECRET=

# --- Scheduled jobs --------------------------------------------------------
# Shared secret for POST /api/cron/expire, sent as "Authorization: Bearer ...".
# When unset, that endpoint only accepts an authenticated admin session.
CRON_SECRET=

# --- Affiliate attribution -------------------------------------------------
# Amazon Associates tracking id. When set, Amazon destination URLs are tagged by
# the /go redirect. Amazon is treated as one merchant among many.
AMAZON_ASSOCIATES_TAG=

# ---------------------------------------------------------------------------
# Affiliate network connectors
#
# NOT IMPLEMENTED IN THIS RELEASE. Each connector is declared with the
# credentials it will genuinely need and reports an unconfigured state in
# Admin -> Connectors. Setting these values does not enable importing: an API
# client still has to be written for each network. Manual entry and CSV import
# work today and need no credentials.
# ---------------------------------------------------------------------------

# CJ Affiliate — https://developers.cj.com/
CJ_PERSONAL_ACCESS_TOKEN=
CJ_PUBLISHER_ID=

# Awin — https://wiki.awin.com/index.php/Publisher_API
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# Impact — https://integrations.impact.com/impact-partner/reference
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=

# Rakuten Advertising — https://developers.rakutenadvertising.com/
RAKUTEN_CLIENT_ID=
RAKUTEN_CLIENT_SECRET=
RAKUTEN_SITE_ID=

# Partnerize — https://developer.partnerize.com/
PARTNERIZE_USER_APPLICATION_KEY=
PARTNERIZE_USER_API_KEY=

# Amazon Product Advertising API (bulk import only; requires an approved
# Associates account). The tag above is enough for link attribution.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=

# Direct merchant feed you are authorised to fetch.
DIRECT_FEED_URL=
DIRECT_FEED_AUTH_HEADER=

# ---------------------------------------------------------------------------
# Email for deal alerts
#
# NOT IMPLEMENTED IN THIS RELEASE. Alert rules are stored, matching logic
# exists, but there is no sending transport — so no mail is sent and the UI says
# so plainly. Setting these marks the provider as present; a transport still has
# to be implemented in src/lib/repos/alerts.ts.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
